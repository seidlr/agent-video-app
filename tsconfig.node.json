{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vite.mcp-app.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": ["scripts/fixture-gen-client.ts"]
}
