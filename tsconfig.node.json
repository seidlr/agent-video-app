{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["node", "vite/client", "webmcp-types"],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vite.mcp-app.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts/**/*.ts",
    "server/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["scripts/fixture-gen-client.ts"]
}
