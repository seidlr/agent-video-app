{
  "name": "agent-video-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-node scripts/run-build-skill.ts && vite-node scripts/run-build-server-manifest.ts && vite build",
    "build:mcp-app": "vite build --config vite.mcp-app.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "make-fixture": "tsx scripts/make-fixture-video.ts",
    "mcp:dev": "tsx watch server/http.ts",
    "mcp:stdio": "tsx server/stdio.ts",
    "build:server": "vite-node scripts/run-build-server.ts",
    "mcp:bundle": "npm run build:mcp-app && npm run build:server && mcpb pack server agent-video-studio.mcpb"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mcp-b/global": "5.1.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@vidstack/react": "1.15.6",
    "cors": "2.8.6",
    "dexie": "4.4.6",
    "dexie-react-hooks": "1.1.7",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "kokoro-js": "1.2.1",
    "lucide-react": "0.487.0",
    "mediabunny": "1.56.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.5",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "9.22.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.51.1",
    "@tailwindcss/vite": "4.0.14",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.12",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.0.0",
    "tailwindcss": "4.0.14",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1",
    "vite": "6.2.0",
    "vite-node": "3.0.9",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "3.0.9",
    "webmcp-types": "0.1.7"
  }
}
